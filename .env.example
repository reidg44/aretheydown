# Copy to .env and fill in real values. Never commit .env.
#
# The public status pages (GitHub, AWS, Azure, Cloudflare, Google Cloud) need no credentials.
# These are only for optional account-specific health checks added later.

# Optional: raises GitHub API rate limits if the app ever calls api.github.com.
GITHUB_TOKEN=

# Optional: AWS profile for the account-scoped AWS Health API (needs a Business/Enterprise support plan).
AWS_PROFILE=

# Optional: Azure subscription for Azure Resource Health.
AZURE_SUBSCRIPTION_ID=
